# =============================================================================
# AI Shorts Factory — Environment Template (Phase 0)
# Copy to .env.local (web) / .env (workers). Never commit real secrets.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Karachi

# --- Supabase (Phase 1+) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Cloudflare R2 (Phase 1+) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-shorts-factory
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=3600

# --- Credit defaults (business rules; overridable in system_settings) ---
DAILY_FLOW_CREDIT_BUDGET=50
DEFAULT_SCENE_COUNT=5
DEFAULT_COST_PER_SCENE=10
MAX_GENERATIONS_PER_PROJECT=5
DEFAULT_GENERATION_DURATION_SECONDS=6
DEFAULT_GENERATION_RESOLUTION=720p
DEFAULT_GENERATION_MODEL=gemini-omni-flash

# --- Video assembly defaults ---
FINAL_VIDEO_MAX_SECONDS=59
FINAL_VIDEO_TARGET_WIDTH=1080
FINAL_VIDEO_TARGET_HEIGHT=1920
FINAL_VIDEO_FPS=30

# --- Workers ---
FLOW_WORKER_ENABLED=false
MEDIA_WORKER_ENABLED=false
WORKER_LEASE_SECONDS=120
WORKER_POLL_INTERVAL_MS=2000
WORKER_AUTH_TOKEN=

# --- Google Flow / Playwright (Phase 4 — not production-ready until verified) ---
FLOW_PROVIDER=mock
FLOW_BASE_URL=
FLOW_BROWSER_PROFILE_DIR=
FLOW_BROWSER_PROFILE_ENCRYPTION_KEY=
FLOW_HEADLESS=true
FLOW_DIAGNOSTIC_SCREENSHOT_DIR=./diagnostic-screenshots
# Never store Google passwords. Auth uses encrypted persistent browser session only.

# --- FFmpeg (media-worker) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- Notifications (Phase 6) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Rate limiting / security ---
API_RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=10485760
