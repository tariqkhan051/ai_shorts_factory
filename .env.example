# =============================================================================
# AI Shorts Factory — Environment Template (Phase 7)
# Copy to apps/web/.env.local (and worker .env files). Never commit real secrets.
# Production: NODE_ENV=production, PROJECT_STORE=supabase, FLOW_PROVIDER=mock
# unless live gates are explicitly verified. Run: pnpm validate:env -- --production
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Karachi

# Data store: memory (local/dev default) | supabase (required in production)
# If unset: uses supabase when URL+anon key exist, otherwise memory.
PROJECT_STORE=memory

# Object storage: memory (tests) | local (default durable .data/objects) | r2
# Unset or `local` keeps mock scene/final assets across process restarts.
STORAGE_PROVIDER=local

# --- Supabase (Phase 1+) ---
# Apply packages/database/migrations/00001_init.sql before using supabase store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser bundle
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Cloudflare R2 (Phase 1+) ---
# Server-only credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-shorts-factory
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=3600

# --- Credit defaults (business rules; overridable in system_settings) ---
DAILY_FLOW_CREDIT_BUDGET=50
DEFAULT_SCENE_COUNT=5
DEFAULT_COST_PER_SCENE=10
MAX_GENERATIONS_PER_PROJECT=5
# Veo 3.1 - Lite Scenes composer shows fixed 8s / 720p on the settings pill.
DEFAULT_GENERATION_DURATION_SECONDS=8
DEFAULT_GENERATION_RESOLUTION=720p
DEFAULT_GENERATION_ASPECT_RATIO=9:16
# Must match a visible Flow UI model label. Examples observed: Veo 3.1 - Lite | Veo 3.1 - Fast | Veo 3.1 - Quality | Omni 1.1 Flash
DEFAULT_GENERATION_MODEL=Veo 3.1 - Lite
# Optional: UI menu label when it differs from DEFAULT_GENERATION_MODEL
FLOW_MODEL_OPTION_LABEL=

# --- Video assembly defaults ---
FINAL_VIDEO_MAX_SECONDS=59
FINAL_VIDEO_TARGET_WIDTH=1080
FINAL_VIDEO_TARGET_HEIGHT=1920
FINAL_VIDEO_FPS=30

# --- Workers ---
FLOW_WORKER_ENABLED=false
MEDIA_WORKER_ENABLED=false
WORKER_LEASE_SECONDS=120
WORKER_POLL_INTERVAL_MS=2000
WORKER_AUTH_TOKEN=

# --- Google Flow / Playwright (gated live canary) ---
# CI and default local runs MUST keep FLOW_PROVIDER=mock.
# Live values: mock | playwright | google-flow
FLOW_PROVIDER=mock
FLOW_LIVE_ENABLED=false
FLOW_UI_VERIFIED=false
# Canary lock: keep true until Scene 1 live run is manually reviewed.
FLOW_CANARY_ONLY=true
FLOW_MAX_LIVE_SCENES_PER_PROJECT=1
FLOW_MAX_SIMULTANEOUS_GENERATIONS=1
# Set only after confirming the real Google Flow workspace URL.
FLOW_BASE_URL=
FLOW_UI_RECIPE_PATH=packages/flow-adapter/recipes/google-flow.unverified.json
# Optional inline JSON recipe (overrides file when set)
FLOW_UI_RECIPE_JSON=
# Persistent Chromium profile for manual Google sign-in (gitignored). Never store passwords.
FLOW_BROWSER_PROFILE_DIR=./.flow-profile
# Optional encryption helper for profile backups — never store Google passwords.
FLOW_BROWSER_PROFILE_ENCRYPTION_KEY=
# false for manual authentication / canary observation
FLOW_HEADLESS=false
# chrome | msedge | empty (bundled Chromium). Use chrome for Google sign-in.
FLOW_BROWSER_CHANNEL=chrome
FLOW_DIAGNOSTIC_SCREENSHOT_DIR=./diagnostic-screenshots
FLOW_POLL_INTERVAL_MS=5000
FLOW_GENERATION_TIMEOUT_MS=600000
FLOW_REQUIRE_EXACT_OPTIONS=true
FLOW_VERIFY_PROMPT=
FLOW_CANARY_PROMPT=
FLOW_CANARY_PROJECT_ID=
FLOW_CANARY_USER_ID=
FLOW_CANARY_OUT_DIR=./diagnostic-screenshots/canary
FLOW_SPEND_CONFIRMATION_TOKEN=
FLOW_SPEND_CONFIRM_PHRASE=
# Must stay false until you explicitly approve spending real Flow credits.
FLOW_EXECUTE_LIVE=false
# Set true only after reconciling an UNKNOWN_SUBMISSION against the Google account.
FLOW_UNKNOWN_RECONCILED=false
# Cross-process live generation lock (defaults to OS temp dir).
FLOW_LIVE_LOCK_PATH=
FLOW_LIVE_LOCK_STALE_MS=900000
# Never invent Flow HTTP APIs. Stop on CAPTCHA / login walls for human intervention.

# --- FFmpeg (media-worker) ---
FFMPEG_PATH=
FFPROBE_PATH=

# --- Notifications (Phase 6) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Rate limiting / security ---
API_RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=10485760
