{
  "name": "@ai-shorts-factory/flow-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manual": {
      "types": "./dist/manual-generation-package.d.ts",
      "import": "./dist/manual-generation-package.js",
      "default": "./dist/manual-generation-package.js"
    },
    "./status": {
      "types": "./dist/flow-status.d.ts",
      "import": "./dist/flow-status.js",
      "default": "./dist/flow-status.js"
    },
    "./recipe": {
      "types": "./dist/load-recipe.d.ts",
      "import": "./dist/load-recipe.js",
      "default": "./dist/load-recipe.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js",
      "default": "./dist/live.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-shorts-factory/shared-types": "workspace:*",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
