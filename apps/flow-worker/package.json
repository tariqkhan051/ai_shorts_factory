{
  "name": "@ai-shorts-factory/flow-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "verify:scene": "tsx src/verify-scene.ts",
    "canary:scene": "tsx src/canary-scene.ts",
    "auth:session": "tsx src/auth-session.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-shorts-factory/credit-manager": "workspace:*",
    "@ai-shorts-factory/flow-adapter": "workspace:*",
    "@ai-shorts-factory/media-engine": "workspace:*",
    "@ai-shorts-factory/shared-types": "workspace:*",
    "@ai-shorts-factory/storage": "workspace:*",
    "@ai-shorts-factory/validation": "workspace:*",
    "@ai-shorts-factory/workflow-engine": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
