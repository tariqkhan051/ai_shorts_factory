{
  "name": "ai-shorts-factory",
  "private": true,
  "version": "0.0.0",
  "description": "Cloud-based AI short-form video production platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@ai-shorts-factory/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@ai-shorts-factory/validation --filter=@ai-shorts-factory/shared-types --filter=@ai-shorts-factory/workflow-engine --filter=@ai-shorts-factory/credit-manager --filter=@ai-shorts-factory/n8n-integration",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "validate:env": "node ./scripts/validate-env.mjs",
    "db:migrate": "node ./scripts/migrate-check.mjs",
    "deploy:web": "pwsh -File ./scripts/deploy-web.ps1",
    "deploy:workers": "pwsh -File ./scripts/deploy-workers.ps1",
    "audit:deps": "pnpm audit --audit-level=high",
    "game-knowledge:import": "node ./scripts/import-game-knowledge.mjs",
    "match:analyze-roster": "node ./scripts/analyze-match-roster.mjs",
    "match:analyze-timeline": "node ./scripts/analyze-match-timeline.mjs",
    "match:commentary": "node ./scripts/generate-match-commentary.mjs",
    "match:edit": "node ./scripts/assemble-match-edit.mjs",
    "game-knowledge:sync": "node ./scripts/sync-game-knowledge-artifacts.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
